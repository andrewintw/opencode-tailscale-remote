# Copy this file to ~/.oc-tailnet.env, then set a strong password and:
#   chmod 600 ~/.oc-tailnet.env
OPENCODE_SERVER_PASSWORD="change-me-to-a-strong-password"

# Optional: override the listen address (default: the Tailscale IPv4 address).
# Set this to 0.0.0.0 when Tailscale runs on Windows but OpenCode runs inside
# WSL, and restrict access with Windows Firewall / Tailscale ACL.
# OPENCODE_BIND_HOST="0.0.0.0"
